# ==============================================================================
# Gitignore for Amazon ML Challenge 2026 — student_resource
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/

# Operating System Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
__MACOSX/

# IDE and Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
.gemini/

# Jupyter Notebook & Testing Caches
.ipynb_checkpoints
.pytest_cache/

# Hugging Face & PyTorch Caches
.cache/
hf_cache/
huggingface/
*.tmp

# Logging & Task Diagnostics
*.log
.system_generated/

# Archives
*.zip
*.tar
*.tar.gz
*.rar

# Scratch & Temporary Directories
scratch/
tmp/
temp/
